{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-video-ia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Fait tourner le site près de la base Supabase (Irlande, aws eu-west-1) : chaque requête à la base
  // passe de ~400 ms (depuis Antananarivo) à quelques millisecondes
  "placement": { "region": "aws:eu-west-1" },
  // Garde les variables ajoutées dans le tableau de bord Cloudflare lors de chaque mise en ligne
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
