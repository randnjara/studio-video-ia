# Copier ce fichier en .env.local pour travailler sur votre ordinateur.
# Sur Cloudflare, ces valeurs se mettent dans Réglages > Variables et secrets.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète, uniquement côté serveur (sert à inviter les membres)
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site, pour les liens de connexion envoyés par e-mail
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé secrète RunPod (Settings > API Keys), pour générer les vidéos
RUNPOD_API_KEY=
